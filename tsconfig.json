{
  "include": ["src/**/*", "types"],
  "compilerOptions": {
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "lib": ["es2017"],
    "target": "es2017",
    "outDir": "./tmp/ignore",
    "declaration": true,
    "noEmitOnError": true,
    "noErrorTruncation": true,
    "checkJs": true,
    "module": "nodenext",
    "resolveJsonModule": true,
    "strict": true,
    "strictNullChecks": false,
    "stripInternal": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [],
    "paths": {
      "types": ["./types/interfaces.js"],
    },
  },
}
